# Public: safe to include in browser bundles. Never put service-role keys here.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private: server only. Needed for production quotas and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SECRET=

# Private: live AI. The sample demo works without these.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Economical stable model listed in Google's official catalog on 2026-11-02.
# Recheck your account's model availability before deployment.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional private cost-estimate rates. Leave blank until you verify your model's
# current per-million-token rates. Logs include counts only, never content.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Independent verification/search: not implemented in this release.
# No search API key is consumed, and no claim is marked independently verified.
# Bot protection: no widget integration in this release. Production quotas are mandatory.
